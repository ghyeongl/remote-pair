#!/usr/bin/env bash
# xpair-mount — Mount-based file access for Xpair (ALTERNATIVE to Syncthing).
#
# Philosophy / trade-off:
#   Mount option:    single source of truth on the host — no sync daemon, no conflicts, no local copy.
#                    Higher interactive latency (every read crosses SSH/SMB). Best for browsing,
#                    occasional edits, or workflows where zero-conflict matters more than speed.
#   Syncthing option: local copy — low read latency, offline-capable, but requires daemon + conflict
#                    resolution. Best for heavy interactive editing with claude locally.
#
# SMB-only backend (selectable as --backend smb for backward-compatible callers):
#   smb   — macOS-native, NO kernel extension. Uses NetFS/Finder-style mounting.
#           HOST PREREQUISITE: System Settings > General > Sharing > File Sharing must be
#           enabled on the host, and the target folder must be in the shared list.
#           The share name defaults to the top-level folder name (macOS auto-registers it).
#
# Folder mappings (FOLDER_MAPS) can point at the mountpoint so editors/file-browsers see
# host files directly without any additional path translation layer.
#
# Usage:
#   xpair-mount [--backend smb] mount   <hostPath>
#   xpair-mount [--backend smb] unmount <mountpoint|hostPath>
#   xpair-mount status
#   xpair-mount help

set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ── config (split runtime dirs) ──
RP_DIR="${RP_DIR:-$HOME/.xpair/host}"
RP_HOST_DIR="${RP_HOST_DIR:-$HOME/.xpair/host}"
RP_CLIENT_DIR="${RP_CLIENT_DIR:-$HOME/.xpair/client}"
if [ -f "$RP_CLIENT_DIR/client.env" ]; then
  for _f in common client; do
    # shellcheck disable=SC1090
    [ -f "$RP_CLIENT_DIR/$_f.env" ] && { set -a; . "$RP_CLIENT_DIR/$_f.env"; set +a; }
  done
else
  for _f in common client; do
    # shellcheck disable=SC1090
    [ -f "$RP_HOST_DIR/$_f.env" ] && { set -a; . "$RP_HOST_DIR/$_f.env"; set +a; }
  done
fi
# shellcheck disable=SC1090
[ -f "$RP_HOST_DIR/host.env" ] && { set -a; . "$RP_HOST_DIR/host.env"; set +a; }
REMOTE_HOST="${REMOTE_HOST:-}"
MOUNT_BACKEND="${MOUNT_BACKEND:-smb}"

# Dedicated pairing identity: offer ~/.xpair/host/pairing_ed25519 on every SSH helper (SMB-state
# probe, whoami) so a paired client authenticates. Added with -i but WITHOUT IdentitiesOnly, so
# ssh still falls back to the user's normal key when the pairing key isn't authorized yet
# (unproven pairing). Empty until the key exists; scalar → set -u safe.
PAIRING_KEY="$RP_HOST_DIR/pairing_ed25519"
SSH_ID=""; [ -f "$PAIRING_KEY" ] && SSH_ID="-i $PAIRING_KEY"
ssh() { command ssh $SSH_ID "$@"; }

# Default NetFS mountpoint root. macOS chooses /Volumes/<share> or a suffixed variant.
MOUNTS_ROOT="/Volumes"

# Source the shared logger; no-op fallback for partially-updated clients.
# shellcheck disable=SC1090
[ -f "$RP_CLIENT_DIR/bin/logging.sh" ] && . "$RP_CLIENT_DIR/bin/logging.sh"
type rp_log >/dev/null 2>&1 || { rp_log(){ :; }; log_info(){ :; }; log_warn(){ printf '%s\n' "$*" >&2; }; log_error(){ printf '%s\n' "$*" >&2; }; err(){ printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }; info(){ printf '\033[1;36m▸ %s\033[0m\n' "$*"; }; warn(){ printf '\033[1;33m⚠ %s\033[0m\n' "$*" >&2; }; }

# ── UI-only helper (not err/info/warn — those come from logging.sh or the fallback above) ──
ok() { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }

# ── arg parsing ──
BACKEND="$MOUNT_BACKEND"
SUBCMD=""
SUBCMD_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --backend|-b)
      shift
      [ $# -gt 0 ] || { err "--backend requires smb"; exit 2; }
      BACKEND="$1"; shift ;;
    --backend=*) BACKEND="${1#--backend=}"; shift ;;
    mount|unmount|status|help|-h|--help)
      SUBCMD="$1"; shift
      while [ $# -gt 0 ]; do SUBCMD_ARGS+=("$1"); shift; done ;;
    *) err "unknown argument: $1"; exit 2 ;;
  esac
done
SUBCMD="${SUBCMD:-help}"

if [ "$BACKEND" != "smb" ]; then
  case "$SUBCMD:$BACKEND" in
    unmount:sshfs|status:sshfs) BACKEND=smb ;;
    *)
      err "unsupported backend: $BACKEND (SMB is the only supported mount backend; use --backend smb)"
      exit 2
      ;;
  esac
fi

# ── helpers ──
# Mirror the main CLI's valid_host guard: reject empty, option-looking (-…), or any
# host/user containing characters outside [A-Za-z0-9._-] before it reaches ssh/NetFS.
# This helper re-sources client.env, so re-validate here (e.g. -oProxyCommand=… injection).
valid_host() {
  local target="${1:-}" user="" host=""
  case "$target" in ''|-*) return 1 ;; esac
  case "$target" in
    *@*)
      case "$target" in *@*@*|@*|*@) return 1 ;; esac
      user="${target%@*}"; host="${target#*@}"
      case "$user" in ''|-*|*[!A-Za-z0-9._-]*) return 1 ;; esac
      ;;
    *) host="$target" ;;
  esac
  case "$host" in ''|-*|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac
}

smb_host() {
  case "${REMOTE_HOST:-}" in *@*) printf '%s' "${REMOTE_HOST#*@}" ;; *) printf '%s' "${REMOTE_HOST:-}" ;; esac
}

# Best-effort probe of the host's File Sharing (SMB) state over SSH → echoes on|off|unknown.
# No sudo: reads launchctl's disabled-override db first (authoritative for the System Settings
# toggle), then falls back to the LaunchDaemon plist. Any failure ⇒ unknown (never blocks).
host_smb_status() {
  valid_host "${REMOTE_HOST:-}" || { printf 'unknown'; return; }
  ssh -o BatchMode=yes -o ConnectTimeout=6 "$REMOTE_HOST" '
    v=$(launchctl print-disabled system 2>/dev/null | sed -n "s/.*\"com.apple.smbd\" => \(.*\)/\1/p")
    case "$v" in
      *true*|*disabled*)  echo off;  exit 0 ;;
      *false*|*enabled*)  echo on;   exit 0 ;;
    esac
    # Fallback when print-disabled yields nothing: the static plist is NOT authoritative for the live
    # toggle (Disabled=1 by factory default), so only explicit Disabled=0 means "on"; else unknown.
    case "$(defaults read /System/Library/LaunchDaemons/com.apple.smbd Disabled 2>/dev/null)" in
      0) echo on ;; *) echo unknown ;;
    esac
  ' 2>/dev/null || printf 'unknown'
}

require_host() {
  if [ -z "$REMOTE_HOST" ]; then
    err "REMOTE_HOST is not set."
    printf >&2 '  Set it with:  xpair config set host <ssh-alias>\n'
    printf >&2 '  Or in ~/.xpair/client/client.env:  REMOTE_HOST=<ssh-alias>\n'
    exit 1
  fi
  if ! valid_host "$REMOTE_HOST"; then
    err "invalid REMOTE_HOST rejected: $REMOTE_HOST"
    printf >&2 '  A host must contain only [A-Za-z0-9._-] and must not look like an ssh option.\n'
    exit 1
  fi
}

# Detect SMB user on the host (SSH → whoami).
smb_user() {
  ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$REMOTE_HOST" whoami 2>/dev/null || id -un 2>/dev/null || printf 'user'
}

share_name_for_hostpath() {
  basename "$1"
}

expected_mountpoint() {
  printf '%s/%s' "$MOUNTS_ROOT" "$(share_name_for_hostpath "$1")"
}

applescript_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

smb_mount_url() {
  local user="$1" host="$2" share="$3"
  printf 'smb://%s@%s/%s' "$user" "$host" "$share"
}

smb_mount_source() {
  local user="$1" host="$2" share="$3"
  printf '//%s@%s/%s' "$user" "$host" "$share"
}

discover_mountpoint_for_share() {
  local user="$1" host="$2" share="$3" exact fallback
  exact="$(smb_mount_source "$user" "$host" "$share") on "
  fallback="@${host}/${share} on "
  mount 2>/dev/null | awk -v exact="$exact" -v fallback="$fallback" '
    index($0, exact) == 1 && index($0, " (smbfs") {
      rest = substr($0, length(exact) + 1)
      idx = index(rest, " (smbfs")
      if (idx) { print substr(rest, 1, idx - 1); exit }
    }
    index($0, fallback) && index($0, " (smbfs") {
      start = index($0, " on ")
      rest = substr($0, start + 4)
      idx = index(rest, " (smbfs")
      if (idx) { print substr(rest, 1, idx - 1); exit }
    }
  ' || true
}

discover_mountpoint_for_hostpath() {
  local hostpath="$1" user="${2:-}" share
  share="$(share_name_for_hostpath "$hostpath")"
  [ -n "$user" ] || user="$(smb_user)"
  discover_mountpoint_for_share "$user" "$(smb_host)" "$share"
}

is_mounted() {
  [ -n "$(discover_mountpoint_for_hostpath "$1" 2>/dev/null)" ]
}

netfs_mount() {
  local url="$1" escaped
  if command -v osascript >/dev/null 2>&1; then
    escaped="$(applescript_escape "$url")"
    osascript -e "mount volume \"$escaped\""
  elif command -v open >/dev/null 2>&1; then
    open "$url"
  else
    return 127
  fi
}

# ── subcommand: mount ──
cmd_mount() {
  require_host

  local hostpath="${SUBCMD_ARGS[0]:-}"
  local mountpoint="${SUBCMD_ARGS[1]:-}"

  if [ -z "$hostpath" ]; then
    err "mount requires a host path.  Usage: xpair-mount mount <hostPath>"
    exit 2
  fi

  if [ -n "$mountpoint" ]; then
    err "custom mountpoints are not supported; macOS NetFS chooses the /Volumes mountpoint."
    printf >&2 '  Expected first choice: %s\n' "$(expected_mountpoint "$hostpath")"
    exit 2
  fi

  # Guard: already mounted?
  local smb_user_name share_name smb_url discovered
  smb_user_name="$(smb_user)"
  share_name="$(share_name_for_hostpath "$hostpath")"
  discovered="$(discover_mountpoint_for_share "$smb_user_name" "$(smb_host)" "$share_name")"
  if [ -n "$discovered" ]; then
    ok "Already mounted at $discovered"
    # Emit the same Mountpoint: line the success path prints so onboarding-bridge.mount()
    # parses a non-empty mountpoint on an idempotent re-mount (else code 0 + empty → false failure).
    printf '  Mountpoint: %s\n' "$discovered"
    return 0
  fi

  case "$BACKEND" in
    smb)
      smb_url="$(smb_mount_url "$smb_user_name" "$(smb_host)" "$share_name")"
      info "Mounting via SMB NetFS: $smb_url"
      printf >&2 '  Note: the host must have File Sharing enabled:\n'
      printf >&2 '    System Settings > General > Sharing > File Sharing\n'
      printf >&2 '  and "%s" must be in the shared folders list.\n' "$hostpath"
      if ! netfs_mount "$smb_url"; then
        err "NetFS mount failed."
        # Probe the actual cause instead of leaving a bare failure: the #1 reason is File Sharing
        # being OFF on the host (the mount has nothing to connect to).
        case "$(host_smb_status)" in
          off) printf >&2 '  ▶ Cause: File Sharing (SMB) is OFF on %s — turn it ON in\n     System Settings > General > Sharing > File Sharing, then add "%s" to the shared list.\n' "$REMOTE_HOST" "$hostpath" ;;
          on)  printf >&2 '  ▶ File Sharing is ON on %s, so "%s" is likely not in the shared folders (or the share name differs).\n' "$REMOTE_HOST" "$hostpath" ;;
          *)   printf >&2 '  ▶ Could not probe %s File Sharing state over SSH (host unreachable or check unavailable).\n' "$REMOTE_HOST" ;;
        esac
        printf >&2 '  Troubleshooting:\n'
        printf >&2 '    1. Verify File Sharing is ON on the host (System Settings > General > Sharing).\n'
        printf >&2 '    2. Ensure the folder "%s" is shared (or a parent folder is shared).\n' "$hostpath"
        printf >&2 '    3. Check the share name: by default macOS uses the folder'"'"'s basename.\n'
        exit 1
      fi
      local i
      for i in 1 2 3 4 5; do
        discovered="$(discover_mountpoint_for_share "$smb_user_name" "$(smb_host)" "$share_name")"
        [ -n "$discovered" ] && break
        sleep 0.2
      done
      if [ -z "$discovered" ]; then
        err "SMB mount completed but the mountpoint could not be discovered from mount(8)."
        printf >&2 '  Looked for: %s on <path> (smbfs...)\n' "$(smb_mount_source "$smb_user_name" "$(smb_host)" "$share_name")"
        exit 1
      fi
      ok "Mounted $REMOTE_HOST:$hostpath at $discovered (SMB)"
      ;;
  esac

  printf '  Mountpoint: %s\n' "$discovered"
  printf '  Tip: add FOLDER_MAPS entry so editors resolve to this path:\n'
  printf '    xpair map add %q %q\n' "$discovered" "$hostpath"
}

# ── subcommand: unmount ──
cmd_unmount() {
  local target="${SUBCMD_ARGS[0]:-}"
  if [ -z "$target" ]; then
    err "unmount requires a mountpoint or hostPath.  Usage: xpair-mount unmount <mountpoint|hostPath>"
    exit 2
  fi

  local mountpoint="$target"
  case "$target" in
    "$MOUNTS_ROOT"/*) mountpoint="${target%/}" ;;
    *)
      require_host
      mountpoint="$(discover_mountpoint_for_hostpath "$target")"
      if [ -z "$mountpoint" ]; then
      err "Cannot find mountpoint for: $target"
        printf >&2 '  Expected first choice: %s\n' "$(expected_mountpoint "$target")"
      printf >&2 '  Run: xpair-mount status\n'
      exit 1
    fi
      ;;
  esac

  if ! mount 2>/dev/null | grep -qF " on ${mountpoint} "; then
    warn "Nothing appears to be mounted at $mountpoint"
    exit 0
  fi

  info "Unmounting $mountpoint ..."
  if ! diskutil unmount "$mountpoint" 2>/dev/null && ! umount "$mountpoint" 2>/dev/null; then
    err "umount failed for $mountpoint"
    printf >&2 '  If the volume is busy, try:\n'
    printf >&2 '    diskutil unmount force "%s"\n' "$mountpoint"
    exit 1
  fi

  # Verify detached.
  if mount 2>/dev/null | grep -qF " on ${mountpoint} "; then
    err "Unmount command ran but $mountpoint still appears mounted."
    exit 1
  fi

  ok "Unmounted $mountpoint"
}

# ── subcommand: status ──
cmd_status() {
  info "Active Xpair mounts (via SMB):"
  local found=0
  local line
  while IFS= read -r line; do
    case "$line" in
      *smbfs*)
        if [ -n "$REMOTE_HOST" ]; then
          case "$line" in
            *"@$(smb_host)/"*) printf '  %s\n' "$line"; found=1 ;;
          esac
        else
          printf '  %s\n' "$line"; found=1
        fi
        ;;
    esac
  done < <(mount 2>/dev/null)

  if [ "$found" -eq 0 ]; then
    printf '  (none)\n'
  fi
}

# ── subcommand: help ──
cmd_help() {
  sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'
}

# ── dispatch ──
case "$SUBCMD" in
  mount)    cmd_mount ;;
  unmount)  cmd_unmount ;;
  status)   cmd_status ;;
  help|-h|--help) cmd_help ;;
  *) err "unknown subcommand: $SUBCMD"; cmd_help; exit 2 ;;
esac
